{
  "name": "motion-studio",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:browser": "playwright test",
    "check": "npm run test && npm run lint && npm run build",
    "serve": "node --experimental-strip-types server/main.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "@types/pngjs": "6.0.5",
    "eslint": "^9.39.0",
    "gifuct-js": "2.1.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "gifenc": "1.0.3",
    "pngjs": "7.0.0"
  }
}
